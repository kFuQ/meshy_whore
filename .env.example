# Copy to .env and fill in your values. .env is git-ignored.

# Your fal.ai API key. Get one at https://fal.ai/dashboard/keys
# If set, it is used for the session and takes precedence over the stored key.
FAL_KEY=

# Optional: passphrase used to derive the AES-256-GCM master key that encrypts
# your stored settings/history. If unset, a random key file is generated and
# kept (0600) in the app data directory. Set this to make your encrypted data
# portable across machines.
# MESHY_MASTER_KEY=

# Optional: override where Meshy Studio stores its encrypted data.
# MESHY_STUDIO_HOME=
